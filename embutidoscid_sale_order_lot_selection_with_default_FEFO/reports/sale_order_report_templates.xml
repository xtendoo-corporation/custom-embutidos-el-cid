<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reporte de Pedido de Venta - Añadir Lote y Fecha de Caducidad -->
    <template id="report_saleorder_document_lot_inherit" inherit_id="sale.report_saleorder_document">
        <!-- Añadir columna de Lote en el encabezado -->
        <xpath expr="//table[@class='o_has_total_table table o_main_table table-borderless']/thead/tr/th[@name='th_quantity']" position="after">
            <th name="th_lot_number" class="text-start" groups="stock.group_production_lot">Lote</th>
            <th name="th_lot_expiration_date" class="text-start" groups="stock.group_production_lot">Fecha de caducidad</th>
        </xpath>

        <!-- Añadir datos de Lote y Fecha de Caducidad en las líneas de producto -->
        <xpath expr="//table[@class='o_has_total_table table o_main_table table-borderless']/tbody//tr[@name='tr_product']/td[@name='td_product_quantity']" position="after">
            <td name="td_lot_number" class="text-start" groups="stock.group_production_lot">
                <span t-if="line.lot_id" t-field="line.lot_id.name"/>
            </td>
            <td name="td_lot_expiration_date" class="text-start" groups="stock.group_production_lot">
                <span t-if="line.expiration_date" t-field="line.expiration_date" t-options="{'widget': 'date'}"/>
            </td>
        </xpath>

        <!-- Añadir columnas vacías para secciones -->
        <xpath expr="//table[@class='o_has_total_table table o_main_table table-borderless']/tbody//tr[@name='tr_section']/td[@name='td_section_name']" position="attributes">
            <attribute name="t-att-colspan">section_name_colspan + 2 if show_section_total else 99</attribute>
        </xpath>

        <!-- Actualizar colspan de secciones agrupadas -->
        <xpath expr="//table[@class='o_has_total_table table o_main_table table-borderless']/tbody//tr[@name='tr_section_group']/td[@name='td_section_group_quantity']" position="after">
            <td name="td_section_group_lot" groups="stock.group_production_lot"/>
            <td name="td_section_group_expiration" groups="stock.group_production_lot"/>
        </xpath>
    </template>
</odoo>

