<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_form_expiration_date_editable" model="ir.ui.view">
        <field name="name">purchase.order.form.expiration.date.editable</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/list/field[@name='expiration_date']"
                position="attributes"
            >
                <attribute name="readonly">state in ('purchase', 'to approve', 'cancel')</attribute>
            </xpath>

            <xpath
                expr="//field[@name='order_line']/form//field[@name='expiration_date']"
                position="attributes"
            >
                <attribute name="readonly">state in ('purchase', 'to approve', 'cancel')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
