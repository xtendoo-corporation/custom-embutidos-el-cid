<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">

        <xpath expr="//div[@id='informations']" position="before">
            <style name="invoice_report_custom">
                html { font-size: 11.5px; }
                .table td, .table th {
                    padding: 0.2rem 0.3rem;
                }
                th[name="th_priceunit"],
                th[name="th_discount"],
                th[name="th_subtotal"] {
                    white-space: nowrap;
                }
            </style>
        </xpath>

        <xpath expr="//th[@name='th_priceunit']/span" position="replace">
            <span>Precio</span>
        </xpath>

        <!-- Quitar la columna de Fecha de Caducidad (añadida por el módulo FEFO) -->
        <xpath expr="//th[@name='th_lot_expiration_date']" position="replace"/>
        <xpath expr="//td[@name='td_lot_expiration_date']" position="replace"/>

        <!-- Quitar la columna de Impuestos y forzar que se muestre siempre la de Descuento en su lugar -->
        <xpath expr="//t[@t-set='display_taxes']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>
        <xpath expr="//t[@t-set='display_discount']" position="attributes">
            <attribute name="t-value">True</attribute>
        </xpath>

    </template>
</odoo>
