<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_embutidos" model="ir.ui.view">
        <field name="name">res.users.embutidos.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Intentar insertar los campos en la pestaña Preferencias.
                 Usamos un selector por presencia de un campo conocido ('lang') dentro de la pestaña
                 en lugar de usar el atributo 'string' (no permitido en herencia de vistas). -->
            <xpath expr="//page[.//field[@name='lang']]" position="inside">
                <group>
                    <field name="allow_product_edit"/>
                    <field name="product_key" password="True"/>
                </group>
            </xpath>
            <!-- Fallback para versiones/plantillas donde no exista la pestaña Preferencias -->
            <xpath expr="//field[@name='login']" position="after">
                <group>
                    <field name="allow_product_edit"/>
                    <field name="product_key" password="True"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

