<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">

        <xpath expr="//div[@id='informations']" position="before">
            <style name="invoice_report_custom">
                html { font-size: 11.5px; }
                .table td, .table th {
                    padding: 0.2rem 0.3rem;
                }
                th[name="th_lot_expiration_date"] {
                    font-size: 0;
                    line-height: 0;
                    color: transparent;
                    width: 65px;
                    white-space: nowrap;
                }
                th[name="th_lot_expiration_date"]::before {
                    content: "F. Caduc.";
                    font-size: 11.5px;
                    line-height: normal;
                    color: #000;
                }
                th[name="th_priceunit"],
                th[name="th_discount"],
                th[name="th_taxes"],
                th[name="th_subtotal"] {
                    white-space: nowrap;
                }
            </style>
        </xpath>

        <xpath expr="//th[@name='th_priceunit']/span" position="replace">
            <span>Precio</span>
        </xpath>

    </template>
</odoo>
