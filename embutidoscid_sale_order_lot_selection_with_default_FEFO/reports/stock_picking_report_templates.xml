<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reporte de Albarán/Entrega - Añadir Fecha de Caducidad -->

    <!-- Añadir columna de Fecha de Caducidad en el encabezado -->
    <template id="report_delivery_document_lot_inherit" inherit_id="stock.report_delivery_document">
        <xpath expr="//th[@name='lot_serial']" position="after">
            <th name="th_lot_expiration_date" class="text-end" groups="stock.group_production_lot" style="white-space:nowrap;">F. Caduc.</th>
        </xpath>
    </template>

    <!-- Añadir dato de Fecha de Caducidad en las líneas con lote/serial -->
    <template id="stock_report_delivery_has_serial_move_line_inherit" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[@name='move_line_lot_quantity']" position="before">
            <td name="td_lot_expiration_date" class="text-end" groups="stock.group_production_lot">
                <span t-if="move_line.lot_id.expiration_date" t-field="move_line.lot_id.expiration_date" t-options="{'widget': 'date'}"/>
            </td>
        </xpath>
    </template>
</odoo>

