<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_embutidos_product_key_wizard" model="ir.ui.view">
        <field name="name">embutidos.product.key.wizard.form</field>
        <field name="model">embutidos.product.key.wizard</field>
        <field name="arch" type="xml">
            <form string="Validar clave de producto">
                <group>
                    <field name="key"/>
                </group>
                <footer>
                    <button string="Validar" type="object" name="action_validate" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_embutidos_product_key_wizard" model="ir.actions.act_window">
        <field name="name">Validar clave producto</field>
        <field name="res_model">embutidos.product.key.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

