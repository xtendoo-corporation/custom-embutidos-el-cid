<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_embutidos_product" model="ir.ui.view">
        <field name="name">product.template.form.inherit.embutidos.product</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='weight']" position="before">
                <field name="is_weighed"/>
            </xpath>
        </field>
    </record>
</odoo>
