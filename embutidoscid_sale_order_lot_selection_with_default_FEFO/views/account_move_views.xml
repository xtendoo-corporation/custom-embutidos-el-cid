<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Vista de factura para mostrar lote y fecha de caducidad en las líneas -->
    <record id="view_move_form_lot_expiration" model="ir.ui.view">
        <field name="name">account.move.form.lot.expiration</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Añadir campos después del product_uom_id en las líneas de factura -->
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='product_uom_id'][@groups='uom.group_uom']"
                position="after"
            >
                <field
                    name="lot_id"
                    optional="show"
                    groups="stock.group_production_lot"
                    context="{'default_product_id': product_id}"
                    invisible="not product_id or display_type in ('line_section', 'line_note')"
                />
                <field
                    name="expiration_date"
                    optional="show"
                    groups="stock.group_production_lot"
                    invisible="not product_id or display_type in ('line_section', 'line_note')"
                />
            </xpath>
        </field>
    </record>
</odoo>

