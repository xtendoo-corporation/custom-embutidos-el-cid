<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <t t-name="embutidos.ProductKeyDialog" owl="1">
    <Dialog size="'sm'" title="props.title" modalRef="modalRef">
      <div class="o_dialog_body">
        <div class="form-group">
          <input type="text" t-att-placeholder="props.placeholder" t-model="state.value" class="form-control" t-on-keydown="_onKeydown" autocomplete="off" name="embutidos_product_key" autocapitalize="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" style="-webkit-text-security: disc;"/>
        </div>
      </div>
      <t t-set-slot="footer">
        <button class="btn btn-primary" t-on-click="_confirm">Aceptar</button>
        <button class="btn btn-secondary" t-on-click="_cancel">Cancelar</button>
      </t>
    </Dialog>
  </t>

</templates>


