<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Añadir botón en la vista formulario de product.template -->
    <record id="view_product_template_form_inherit_embutidos" model="ir.ui.view">
        <field name="name">product.template.form.embutidos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <header>
                    <button name="%(action_embutidos_product_key_wizard)d" type="action" string="Validar clave" class="btn-secondary"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Añadir botón en la vista formulario de product.product (variantes) -->
    <record id="view_product_product_form_inherit_embutidos" model="ir.ui.view">
        <field name="name">product.product.form.embutidos</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <header>
                    <button name="%(action_embutidos_product_key_wizard)d" type="action" string="Validar clave" class="btn-secondary"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>

